  "paths": {
    "/capability/call/add_two_ints": {
      "post": {
        "summary": "Call ROS 2 service /add_two_ints",
        "operationId": "call_add_two_ints",
        "x-ros-capability": {
          "kind": "call",
          "name": "/add_two_ints",
          "type": "example_interfaces/srv/AddTwoInts"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "a": {
                    "type": "string",
                    "format": "int64",
                    "pattern": "^-?[0-9]+n$",
                    "example": "42n",
                    "description": "ROS 2 int64, transmitted as a BigInt-string (e.g. \"42n\") for precision-safety."
                  },
                  "b": {
                    "type": "string",
                    "format": "int64",
                    "pattern": "^-?[0-9]+n$",
                    "example": "42n",
                    "description": "ROS 2 int64, transmitted as a BigInt-string (e.g. \"42n\") for precision-safety."
                  }
                },
                "required": [
                  "a",
                  "b"
                ],
                "x-ros-type": "example_interfaces/srv/AddTwoInts_Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ROS 2 service response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sum": {
                      "type": "string",
                      "format": "int64",
                      "pattern": "^-?[0-9]+n$",
                      "example": "42n",
                      "description": "ROS 2 int64, transmitted as a BigInt-string (e.g. \"42n\") for precision-safety."
                    }
                  },
                  "required": [
                    "sum"
                  ],
                  "x-ros-type": "example_interfaces/srv/AddTwoInts_Response"
                }
              }
            }
          },
          "404": {
            "description": "Capability not exposed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "const": "not_exposed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
